{
  "tasks": [
    {
      "type": "cppbuild",
      "label": "C/C++: clang++ build active file",
      "command": "/usr/bin/clang++",
      "args": [
        "-std=gnu++14",
        "-fcolor-diagnostics",
        "-fansi-escape-codes",
        "-I/Volumes/F/vosk/opt/kaldi/src",
        "-I/Volumes/F/vosk/opt/kaldi/vosk-api/src",
        "-I/Volumes/F/vosk/opt/kaldi/tools/openfst/include",
        "-g",
        "${file}",
        "-o",
        "${fileDirname}/${fileBasenameNoExtension}",
        "-L${workspaceFolder}/src/lib",
        "-lkaldi-feat",
        "-lkaldi-util",
        "-lkaldi-matrix",
        "-lkaldi-base",
        "-L${workspaceFolder}/tools/openfst/lib",
        "-lfst",
        "-Wl,-rpath,${workspaceFolder}/src/lib",
        "-Wl,-rpath,${workspaceFolder}/tools/openfst/lib"
      ],
      "options": {
        "cwd": "${fileDirname}"
      },
      "problemMatcher": ["$gcc"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "detail": "Task generated by Debugger."
    }
